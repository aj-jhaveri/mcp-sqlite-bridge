# MCP SQLite Bridge Configuration

# The path to the SQLite database file (local file or ":memory:" for tests)
DB_PATH=mcp_database.db

# Write access. Read-only is the default and is what any public deployment should run:
# the HTTP endpoint is unauthenticated, so an unset or misspelled value must fail safe.
# Only READ_ONLY=false enables add_database_record / update_database_record, and it
# should never be set on a publicly reachable instance.
READ_ONLY=true
