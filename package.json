{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "A Model Context Protocol server giving LLM agents type-safe, read-only access to a local SQLite database by default; write tools are registered only when started with READ_ONLY=false",
  "main": "dist/server.js",
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "postinstall": "npm rebuild sqlite3 --build-from-source",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "demo": "tsx demo/seed-and-query.ts",
    "db:clean": "rm -f mcp_database.db",
    "client": "node dist/client/mcp-client.js"
  },
  "keywords": [],
  "author": "Anish Jhaveri",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/sqlite3": "^3.1.11",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "pino": "^10.3.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
